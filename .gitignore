# Single Root .gitignore for Take_Ride Monorepo

# Private environment files
.env
.env.*
!.env.example

# Dependency directories
node_modules/

# Build & Dist outputs
dist/
dist-ssr/
build/
.vercel/

# Operating System & IDE Files
.DS_Store
Thumbs.db
.vscode/
.idea/
*.suo
*.ntvs*
*.njsproj
*.sln
*.sw?

# Logs & Debugging
*.log
logs/
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*
lerna-debug.log*
