# Server Configuration
PORT=5000
NODE_ENV=development
FRONTEND_URL=http://localhost:5173

# Database (MongoDB & Redis)
DB_URL=mongodb://127.0.0.1:27017/go_ride
REDIS_HOST=127.0.0.1
REDIS_PORT=6379
REDIS_USERNAME=
REDIS_PASSWORD=

# Security & Authentication
BCRYPT_SALT_ROUND=10
JWT_ACCESS_SECRET=your_super_secret_access_key_12345
JWT_ACCESS_EXPIRES=1d
JWT_REFRESH_SECRET=your_super_secret_refresh_key_12345
JWT_REFRESH_EXPIRES=30d
EXPRESS_SESSION_SECRET=your_express_session_secret_12345

# Owner / Admin Credentials
ADMIN_EMAIL=admin@goride.com
ADMIN_PASSWORD=admin@123

# Google OAuth (Optional)
GOOGLE_CLIENT_ID=your_google_client_id
GOOGLE_CLIENT_SECRET=your_google_client_secret
GOOGLE_CALLBACK_URL=http://localhost:5000/api/v1/auth/google/callback

# SSLCommerz Payment Gateway (Optional / Sandbox)
SSL_STORE_ID=testbox
SSL_STORE_PASS=gw_testbox
SSL_PAYMENT_API=https://sandbox.sslcommerz.com/gwprocess/v4/api.php
SSL_VALIDATION_API=https://sandbox.sslcommerz.com/validator/api/validationserverAPI.php
SSL_SUCCESS_FRONTEND_URL=http://localhost:5173/payment/success
SSL_FAIL_FRONTEND_URL=http://localhost:5173/payment/fail
SSL_CANCEL_FRONTEND_URL=http://localhost:5173/payment/cancel
SSL_SUCCESS_BACKEND_URL=http://localhost:5000/api/v1/payment/success
SSL_FAIL_BACKEND_URL=http://localhost:5000/api/v1/payment/fail
SSL_CANCEL_BACKEND_URL=http://localhost:5000/api/v1/payment/cancel
SSL_IPN_URL=http://localhost:5000/api/v1/payment/ipn

# Cloudinary (Media Uploads)
CLOUDINARY_CLOUD_NAME=your_cloud_name
CLOUDINARY_API_KEY=your_api_key
CLOUDINARY_API_SECRET=your_api_secret

# SMTP Email Sender (Nodemailer)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=your_email@gmail.com
SMTP_PASS=your_app_password
SMTP_FROM=GoRide <your_email@gmail.com>
